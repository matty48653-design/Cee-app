from flask import Flask, jsonify, request
from flask_cors import CORS
import datetime

app = Flask(__name__)
CORS(app)  # Allows your frontend matrix to safely pull the live data

# This stores your exact structure dynamically in memory instead of a locked file
LIVE_MATRIX_DATA = {
    "framework_version": "9.5-Quantum-Core",
    "last_checked": "Initializing...",
    "syndicate_tracking": [
        {
            "group": "Alpha Syndicate",
            "size": "Size: 5x",
            "wager": "Sam Houston Pass Volume Sliders",
            "sentiment": "94% Public Resistance"
        },
        {
            "group": "Vegas Sharp Box",
            "size": "Size: 2.5x",
            "wager": "NHL Under Adjustments",
            "sentiment": "74% Public Resistance"
        }
    ],
    "directive_sheet": [
        {
            "label": "LIVE SPREAD RECON",
            "value": "TAKE: Sam Houston Alternate Pass Yards (MORE 175.0 Floor)",
            "desc": "Current market context target: Williams Stadium • Line: Liberty -13.5 (O/U 52.5)."
        },
        {
            "label": "LIVE OVER/UNDER RECON",
            "value": "Analyzing Pacing",
            "desc": "Will display exact live points threshold targets based on quarter pacing."
        }
    ]
}

# 1. FRONTEND FETCH: Your app frontend targets this URL to display data
@app.route('/api/matrix', methods=['GET'])
def get_matrix():
    # Automatically stamps the exact time someone loads or pings the app
    LIVE_MATRIX_DATA["last_checked"] = datetime.datetime.now().strftime("%I:%M %p")
    return jsonify(LIVE_MATRIX_DATA)

# 2. SHARP UPDATE PANEL: Send a POST request here to instantly change the screen data
@app.route('/api/matrix/update', methods=['POST'])
def update_matrix():
    global LIVE_MATRIX_DATA
    new_data = request.get_json()
    
    if not new_data:
        return jsonify({"status": "error", "message": "No data provided"}), 400
        
    # Updates your matrix items in real-time
    LIVE_MATRIX_DATA.update(new_data)
    return jsonify({"status": "success", "message": "CEE Matrix synced successfully!"})

if __name__ == '__main__':
    app.run(host='0.0.0.0', port=10000)
